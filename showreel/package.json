{
  "name": "grokbot-meter-showreel",
  "private": true,
  "version": "1.0.0",
  "description": "30-second motion-graphics showreel for GrokBot Meter",
  "scripts": {
    "preview": "remotion studio src/index.ts --port=3000",
    "render": "remotion render src/index.ts Showreel ../docs/showreel/grokbot-meter-showreel.mp4 --codec=h264 --crf=20 --pixel-format=yuv420p --audio-bitrate=192k",
    "still": "remotion still src/index.ts Showreel",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "@fontsource/outfit": "^5.2.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "^4.0.272"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.272",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "typescript": "~5.8.3"
  }
}
