{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GrokBar",
  "version": "0.1.0",
  "identifier": "app.grokbar.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "GrokBar",
        "width": 380,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "fullscreen": false,
        "shadow": true,
        "focus": false,
        "transparent": true,
        "backgroundColor": [
          0,
          0,
          0,
          0
        ],
        "windowEffects": {
          "effects": [
            "popover"
          ],
          "state": "followsWindowActiveState",
          "radius": 12
        }
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true,
      "showMenuOnLeftClick": false,
      "tooltip": "GrokBar"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
