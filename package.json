{
  "name": "grokbar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "electron:dev": "electron-vite dev --watch",
    "electron:build": "tsc && electron-vite build && electron-builder",
    "electron:preview": "electron-vite preview",
    "perf:baseline": "node scripts/perf/run.mjs --label tauri-baseline",
    "perf:electron": "node scripts/perf/run.mjs --label electron",
    "perf:compare": "node scripts/perf/report.mjs perf-results/tauri-baseline.json perf-results/electron.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^4.0.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "build": {
    "appId": "app.grokbar.desktop",
    "productName": "GrokBar",
    "directories": {
      "buildResources": "src-tauri/icons"
    },
    "files": [
      "dist/**",
      "out/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "src-tauri/icons/icon.icns",
      "minimumSystemVersion": "10.15"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src-tauri/icons/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "src-tauri/icons/32x32.png"
    }
  }
}
