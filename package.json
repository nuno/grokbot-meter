{
  "name": "grokbot-meter",
  "private": true,
  "version": "0.4.2",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "electron:dev": "electron-vite dev --watch",
    "electron:build": "tsc && electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir dmg zip --arm64 && node scripts/organize-release-artifacts.mjs",
    "electron:preview": "electron-vite preview",
    "electron:build:release": "tsc && electron-vite build && electron-builder --mac dmg zip --arm64 && node scripts/organize-release-artifacts.mjs",
    "dist:win": "tsc && electron-vite build && node scripts/electron-builder-unsigned.mjs --win --x64 && node scripts/organize-release-artifacts.mjs",
    "icons:gen": "python3 scripts/gen-packaging-icons.py",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test src/lib/meterReadout.test.ts src/lib/openAtLoginHint.test.ts electron/platform/position.test.ts electron/platform/winTrayBitmap.test.ts electron/platform/winLoginItem.test.ts electron/grokBotPaths.test.ts electron/grokBotApp.test.ts electron/safeStorageCrypt.test.ts scripts/release-artifact-names.test.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "app.grokbotmeter.desktop",
    "productName": "GrokBot Meter",
    "artifactName": "GrokBot-Meter-${version}-${arch}.${ext}",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "out/**"
    ],
    "afterPack": "scripts/after-pack-adhoc-sign.cjs",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icons/icon.icns",
      "minimumSystemVersion": "13.0",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "forceCodeSigning": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icons/icon.png"
    },
    "extraResources": [
      {
        "from": "build/icons/tray.png",
        "to": "tray.png"
      },
      {
        "from": "build/icons/tray@2x.png",
        "to": "tray@2x.png"
      }
    ]
  }
}
