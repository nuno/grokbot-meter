{
  "name": "grokbot-meter",
  "private": true,
  "version": "0.2.5",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "electron:dev": "electron-vite dev --watch",
    "electron:build": "tsc && electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir dmg zip --arm64 && node scripts/organize-release-artifacts.mjs",
    "electron:preview": "electron-vite preview",
    "electron:build:release": "tsc && electron-vite build && electron-builder --mac dmg zip --arm64 && node scripts/organize-release-artifacts.mjs",
    "icons:gen": "python3 scripts/gen-packaging-icons.py"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^36.9.2",
    "electron-builder": "^25.0.0",
    "electron-vite": "^5.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "build": {
    "appId": "app.grokbotmeter.desktop",
    "productName": "GrokBot Meter",
    "artifactName": "GrokBot-Meter-${version}-${arch}.${ext}",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "out/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icons/icon.icns",
      "minimumSystemVersion": "10.15",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "forceCodeSigning": false
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icons/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icons/icon.png"
    },
    "extraResources": [
      {
        "from": "build/icons/tray.png",
        "to": "tray.png"
      },
      {
        "from": "build/icons/tray@2x.png",
        "to": "tray@2x.png"
      }
    ]
  }
}
